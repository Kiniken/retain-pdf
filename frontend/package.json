{
  "name": "front-tailwind-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run prepare:vendor && npm run generate:version && npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./styles.css --minify",
    "build:js": "node ./scripts/build-js-bundle.mjs",
    "generate:version": "node ./scripts/generate-app-version.mjs",
    "prepare:vendor": "node ./scripts/prepare-runtime-deps.mjs",
    "smoke:desktop-first-run": "node ./scripts/desktop-first-run-smoke.mjs",
    "smoke:homepage-actions": "python3 ./scripts/frontend-homepage-actions-smoke.py",
    "smoke:homepage": "python3 ./scripts/frontend-homepage-smoke.py",
    "smoke:mock-submit": "python3 ./scripts/frontend-mock-submit-smoke.py",
    "smoke:parallel-status": "python3 ./scripts/frontend-parallel-status-smoke.py",
    "smoke:status": "node ./scripts/frontend-status-smoke.mjs",
    "test": "node --import ./tests/helpers/register-jsx.mjs --test --test-force-exit tests/*.test.mjs",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./styles.css --watch",
    "watch:js": "node ./scripts/build-js-bundle.mjs --watch",
    "visual:check": "node ./scripts/visual-check.mjs",
    "visual:update": "node ./scripts/visual-check.mjs --update"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "marked": "^18.0.6",
    "mathjax-full": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "4.12.1"
  }
}
